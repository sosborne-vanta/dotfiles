# macOS-only shell setup. zshrc sources this on Darwin, after Oh My Zsh and
# before ~/.aliases and ~/.zshrc.local, so local overrides still win.
# Keep secrets in ~/.zshrc.local (gitignored), never here.

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh (machine-local, not tracked).
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# obsidian lives in ~/code on this Mac, not /workspaces (used by gsync above)
export OBSIDIAN_DIR="${OBSIDIAN_DIR:-$HOME/code/obsidian}"

export PATH=~/.local/bin:$PATH

# Make sure non versioned python commands are available
export PATH=$PATH:/opt/homebrew/opt/python@3.13/libexec/bin

gp-ssh() {
  local env_id
  env_id=$(gitpod environment list \
    | tail -n +2 \
    | fzf --prompt='Select Gitpod env > ' --height=25% --layout=reverse --border \
    | awk '{print $1}')

  [ -n "$env_id" ] && gitpod environment ssh --start "$env_id"
}

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
