{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "python3 /home/vscode/.dev/hooks/providers/claude/finish.py",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "idle_prompt"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "command": "python3 /home/vscode/.dev/hooks/providers/claude/heartbeat.py",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "python3 /home/vscode/.dev/hooks/providers/claude/finish.py",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "command": "python3 /home/vscode/.dev/hooks/providers/claude/finish.py",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "python3 /home/vscode/.dev/hooks/providers/claude/start.py",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "enabledPlugins": {
    "customer-trust-automation-kb@obsidian-local": true,
    "vanta-customer-trust-automation@obsidian-local": true
  }
}
